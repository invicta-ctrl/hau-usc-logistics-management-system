{
  "name": "hau-usc-logistics-management-system",
  "version": "0.8.3",
  "private": true,
  "type": "module",
  "scripts": {
    "extract:visual": "node scripts/extract-visual-baseline.mjs",
    "dev": "vite",
    "dev:frontend:playground": "node scripts/start-frontend-playground-preview.mjs dev",
    "preview:frontend:start": "node scripts/start-frontend-playground-preview.mjs start",
    "preview:frontend:status": "node scripts/start-frontend-playground-preview.mjs status",
    "preview:frontend:restart": "node scripts/start-frontend-playground-preview.mjs restart",
    "preview:frontend:stop": "node scripts/start-frontend-playground-preview.mjs stop",
    "performance:playground:baseline": "node scripts/measure-playground-performance.mjs",
    "build": "npm run verify:frontend:fixture-boundary && npm run design:foundation:check && vite build --mode application",
    "build:apps-script": "node scripts/create-apps-script-bundle.mjs",
    "build:cloudflare": "npm run verify:frontend:fixture-boundary && npm run design:foundation:check && vite build --mode staging --outDir ../.wrangler/build/staging",
    "build:cloudflare:production": "npm run verify:frontend:fixture-boundary && npm run design:foundation:check && vite build --mode production --outDir ../.wrangler/build/production",
    "verify:dist": "node scripts/verify-frontend-dist.mjs",
    "verify:frontend:fixture-boundary": "node scripts/verify-frontend-fixture-boundary.mjs",
    "verify:cloudflare:hero": "node scripts/verify-cloudflare-hero-media.mjs .wrangler/build/staging",
    "verify": "npm run check:apps-script && npm run verify:dist",
    "check:apps-script": "node scripts/check-apps-script.mjs",
    "check:agents": "node scripts/check-agent-instructions.mjs",
    "check:continuation": "node scripts/check-work-continuation.mjs",
    "handoff:verify": "node scripts/handoff-verify.mjs",
    "staging:authorization:init": "node scripts/staging-authorization.mjs init",
    "staging:authorization:check": "node scripts/staging-authorization.mjs check",
    "staging:sandbox:status": "node scripts/staging-sandbox.mjs status",
    "staging:seed-sandbox": "node scripts/staging-sandbox.mjs seed",
    "staging:reset-sandbox": "node scripts/staging-sandbox.mjs reset",
    "staging:sandbox:verify-local": "node scripts/d1/verify-staging-sandbox-local.mjs",
    "reconcile:inventory": "node scripts/d1/reconcile-inventory-truth.mjs",
    "staging:candidate:evidence": "node scripts/staging-candidate-evidence.mjs",
    "staging:candidate:smoke": "node scripts/staging-candidate-smoke.mjs",
    "phase3:authorization:init": "node scripts/phase3-staging-authorization.mjs init",
    "phase3:authorization:check": "node scripts/phase3-staging-authorization.mjs check",
    "production:authorization:init": "node scripts/production-authorization.mjs init",
    "production:authorization:check": "node scripts/production-authorization.mjs check",
    "production:recovery:evidence": "node scripts/production-recovery-evidence.mjs",
    "production:preflight": "node scripts/production-launch-preflight.mjs",
    "release:candidate:manifest": "node scripts/create-release-candidate-manifest.mjs .release/candidate.json",
    "cloudflare:preflight": "node scripts/cloudflare-environment-preflight.mjs",
    "cloudflare:private-configs:init": "node scripts/create-private-cloudflare-configs.mjs",
    "cloudflare:secrets": "node scripts/cloudflare-secret-package.mjs",
    "staging:identity-fixture": "node scripts/configure-staging-identity-fixture.mjs",
    "cloudflare:types": "wrangler types && prettier --write worker-configuration.d.ts",
    "cloudflare:dry-run": "npm run build:cloudflare && npm run verify:cloudflare:hero && wrangler deploy --dry-run --env= --assets .wrangler/build/staging --outdir .wrangler/dry-run",
    "verify:deploy:artifact": "node scripts/verify-deploy-artifact.mjs",
    "deploy:staging": "node scripts/deploy-environment.mjs staging",
    "deploy:production": "node scripts/deploy-environment.mjs production",
    "check:cloudflare": "npm run cloudflare:types && npm run cloudflare:dry-run",
    "cloudflare:dev": "wrangler dev --local",
    "d1:migrations:list:local": "wrangler d1 migrations list DB --local",
    "d1:migrations:apply:local": "wrangler d1 migrations apply DB --local",
    "d1:execute:local": "wrangler d1 execute DB --local",
    "d1:seed:local": "node scripts/d1/create-local-seed.mjs",
    "migration:validate": "node scripts/migration/validate-export.mjs",
    "migration:prepare": "node scripts/migration/prepare-import.mjs",
    "migration:fixture": "node scripts/migration/create-synthetic-export.mjs",
    "check:governance": "npm run check:agents && npm run check:continuation",
    "check:playground": "vitest run tests/unit/playground-baseline-data.test.js tests/unit/playground-baseline-v2.test.js tests/unit/playground-branch-governance.test.js tests/unit/playground-config.test.js tests/unit/playground-deployment-history.test.js tests/unit/playground-evidence-placeholders.test.js tests/unit/playground-governance-files.test.js tests/unit/playground-r2-copy-worker.test.js tests/unit/playground-r2-readonly-fingerprint-worker.test.js tests/unit/playground-r2-reset-worker.test.js tests/unit/playground-service.test.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:frontend": "vitest run tests/unit/frontend-backend-adapter.test.js tests/unit/frontend-playground-guard.test.js",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:frontend": "playwright test --config playwright.frontend.config.js",
    "test:e2e:cloudflare:local": "playwright test --config playwright.cloudflare.config.js",
    "test:e2e:staging:auth": "playwright test --config playwright.staging-auth.config.js",
    "test:e2e:staging:phase23": "playwright test --config playwright.phase23.config.js",
    "lint": "eslint .",
    "lint:release-candidate": "eslint . --ignore-pattern \"prototypes/public-portals-r3/**\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run check:governance && npm run lint && npm run build && npm run test && npm run check:apps-script && npm run verify:dist && npm run check:cloudflare",
    "check:release-candidate": "npm run check:governance && npm run lint:release-candidate && npm run build && npm run test && npm run check:apps-script && npm run verify:dist && npm run check:cloudflare",
    "design:tracker": "node scripts/design/design-tracker.mjs",
    "design:tracker:check": "node scripts/design/design-tracker.mjs --check",
    "design:contrast": "node scripts/design/contrast-audit.mjs",
    "design:theme": "node scripts/design/build-theme.mjs",
    "design:theme:check": "node scripts/design/build-theme.mjs --check",
    "design:foundation": "node scripts/design/build-frontend-foundation.mjs",
    "design:foundation:check": "node scripts/design/build-frontend-foundation.mjs --check",
    "design:make-theme": "node scripts/design/build-make-theme.mjs",
    "design:make-theme:check": "node scripts/design/build-make-theme.mjs --check",
    "design:make-routes": "node scripts/design/build-make-routes.mjs",
    "design:make-routes:check": "node scripts/design/build-make-routes.mjs --check",
    "design:make-verify": "node scripts/design/verify-make-theme.mjs",
    "design:make-landing": "node scripts/design/verify-make-landing-theme.mjs",
    "design:figma-tracker": "node scripts/design/figma-tracker-payload.mjs",
    "design:figma-tracker:check": "node scripts/design/figma-tracker-payload.mjs --check",
    "design:serve": "node scripts/design/serve.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.487.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.12",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.12",
    "vite": "^7.2.7",
    "vitest": "^4.0.15",
    "wrangler": "^4.113.0"
  }
}
