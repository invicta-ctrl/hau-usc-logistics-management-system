{
  "name": "hau-usc-logistics-management-system",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "extract:visual": "node scripts/extract-visual-baseline.mjs",
    "dev": "vite",
    "build": "vite build && node scripts/create-shareable.mjs",
    "build:share": "node scripts/create-shareable.mjs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run test && npm run build && npm run verify:dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.7.4",
    "vite": "^7.2.7",
    "vite-plugin-singlefile": "^2.3.0",
    "vitest": "^4.0.15"
  }
}
