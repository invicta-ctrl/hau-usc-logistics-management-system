function createReservation_(payload,user,idempotencyKey){var item=itemById_(payload.itemId);assertTransactableItem_(item);var quantity=positiveNumber_(payload.quantity,'quantity'),available=availableToPromise_(item.Item_ID);if(quantity>available)throw appError_('INSUFFICIENT_STOCK','Only '+available+' '+item.Unit+' are available to promise.',false,{available:available,itemId:item.Item_ID});var row={Reservation_ID:allocateId_('RSV'),Created_At:nowIso_(),Updated_At:nowIso_(),Item_ID:item.Item_ID,Quantity:quantity,Unit:item.Unit,Request_Line_ID:payload.requestLineId||'',Lending_Ticket_ID:payload.lendingTicketId||'',Status:'ACTIVE',Created_By:user.User_ID,Cleared_At:'',Clear_Reason:'',Idempotency_Key:idempotencyKey,Notes:payload.notes||''};appendObject_(HAU_SHEETS.RESERVATIONS,row);return row;}
function consumeReservations_(itemId,quantity,links,user){var remaining=quantity,rows=findAll_(HAU_SHEETS.RESERVATIONS,function(r){return String(r.Item_ID)===String(itemId)&&String(r.Status)==='ACTIVE'&&(!links.requestLineId||String(r.Request_Line_ID)===String(links.requestLineId))&&(!links.lendingTicketId||String(r.Lending_Ticket_ID)===String(links.lendingTicketId));});var total=rows.reduce(function(s,r){return s+Number(r.Quantity||0);},0);if(total<quantity)throw appError_('RESERVATION_CONFLICT','The active reservation no longer covers this quantity.',false,{reserved:total,requested:quantity});rows.forEach(function(r){if(remaining<=0)return;var take=Math.min(remaining,Number(r.Quantity));var left=Number(r.Quantity)-take;updateObject_(HAU_SHEETS.RESERVATIONS,r._row,{Quantity:left,Status:left===0?'CLEARED':'ACTIVE',Updated_At:nowIso_(),Cleared_At:left===0?nowIso_():'',Clear_Reason:left===0?'PHYSICAL_RELEASE':''});remaining-=take;});}
function reserveStockCommand_(command,correlationId){return withScriptLock_(function(){var user=requirePermission_('Can_Review'),key=requireIdempotency_(command),replay=idempotencyReplay_(key);if(replay)return Object.assign({idempotentReplay:true},replay);var row=createReservation_(command,user,key);var result={reservationId:row.Reservation_ID,entityType:'RESERVATION',entityId:row.Reservation_ID};audit_('RESERVE_STOCK','RESERVATION',row.Reservation_ID,user,correlationId,{after:row,requestId:command.requestId});return recordIdempotency_(key,result,user,correlationId);});}

