function setupUser_(){var email=normalizeEmail_(Session.getActiveUser().getEmail());if(!email)throw appError_('SETUP_IDENTITY_REQUIRED','Run setup from an institutional Google account.',false);var users=readObjects_(HAU_SHEETS.USERS);if(!users.length)return{User_ID:'SETUP_OWNER',Email:email,Role:'ADMIN',Can_Admin:true,Display_Name:'Setup owner'};return requirePermission_('Can_Admin');}
function setConfigValue_(key,value,environment,description,status,user){var row=findOne_(HAU_SHEETS.CONFIG,'Key',key),patch={Key:key,Value:value,Environment:environment||'ALL',Description:description||'',Secret:false,Updated_At:nowIso_(),Updated_By:user&&user.User_ID||'SYSTEM',Validation_Status:status||'VALID'};if(row)updateObject_(HAU_SHEETS.CONFIG,row._row,patch);else appendObject_(HAU_SHEETS.CONFIG,patch);return patch;}
function validateDatabaseSchema_(){var db=getDatabase_(),available=db.getSheets().map(function(s){return s.getName();}),required=Object.keys(HAU_HEADERS),reports=required.map(function(name){return available.indexOf(name)<0?{sheet:name,ok:false,missingSheet:true,missing:HAU_HEADERS[name]}:assertHeaders_(name);});return{spreadsheetId:db.getId(),title:db.getName(),timeZone:db.getSpreadsheetTimeZone(),schemaVersion:HAU_CONFIG.SCHEMA_VERSION,legacySheets:HAU_CONFIG.LEGACY_SHEETS.map(function(name){return{name:name,present:available.indexOf(name)>=0};}),sheets:reports,ok:reports.every(function(r){return r.ok;})&&HAU_CONFIG.LEGACY_SHEETS.every(function(name){return available.indexOf(name)>=0;})};}
function validateDatabaseSchema(){return guardApi_('validateDatabaseSchema',{},function(){setupUser_();return validateDatabaseSchema_();});}
function setupDatabase(){return guardApi_('setupDatabase',{},function(correlationId){return withScriptLock_(function(){var user=setupUser_(),db=getDatabase_(),created=[],headersAdded=[];Object.keys(HAU_HEADERS).forEach(function(name){var s=db.getSheetByName(name);if(!s){s=db.insertSheet(name);created.push(name);}var actual=headers_(name),missing=HAU_HEADERS[name].filter(function(h){return actual.indexOf(h)<0;});if(s.getLastRow()===0||actual.every(function(v){return!v;})){s.getRange(1,1,1,HAU_HEADERS[name].length).setValues([HAU_HEADERS[name]]);headersAdded.push({sheet:name,headers:HAU_HEADERS[name]});}else if(missing.length&&name==='01_ITEM_MASTER'){s.getRange(1,s.getLastColumn()+1,1,missing.length).setValues([missing]);headersAdded.push({sheet:name,headers:missing});}s.setFrozenRows(1);formatBackendSheet_(s);});HAU_CONFIG.DRIVE_KEYS.forEach(function(key){if(!findOne_(HAU_SHEETS.CONFIG,'Key',key))setConfigValue_(key,'TO_BE_ASSIGNED','PRODUCTION','Managed Google Drive folder ID','PENDING',user);});setConfigValue_('SCHEMA_VERSION',HAU_CONFIG.SCHEMA_VERSION,'ALL','Backend schema version','VALID',user);audit_('SETUP_DATABASE','DATABASE',HAU_CONFIG.SPREADSHEET_ID,user,correlationId,{after:{created:created,headersAdded:headersAdded}});return{createdSheets:created,headersAdded:headersAdded,validation:validateDatabaseSchema_()};});});}
function formatBackendSheet_(sheet){var columns=Math.max(1,sheet.getLastColumn());sheet.getRange(1,1,1,columns).setBackground('#3A0608').setFontColor('#FFF7E6').setFontWeight('bold').setWrap(true);if(!sheet.getFilter())sheet.getRange(1,1,Math.max(1,sheet.getLastRow()),columns).createFilter();sheet.autoResizeColumns(1,Math.min(columns,26));}
function validateDriveConfiguration_(){var config=configMap_(),results=HAU_CONFIG.DRIVE_KEYS.map(function(key){var value=config[key],status='VALID',message='Configured';if(!value||value==='TO_BE_ASSIGNED'){status='MISSING';message='Folder ID is not assigned.';}else{try{DriveApp.getFolderById(value).getName();}catch(e){status='INACCESSIBLE';message='Folder cannot be accessed.';}}return{key:key,status:status,message:message};});return{ok:results.every(function(r){return r.status==='VALID';}),folders:results};}
function validateDriveConfiguration(){return guardApi_('validateDriveConfiguration',{},function(){setupUser_();return validateDriveConfiguration_();});}
function setupDriveFolders(){return guardApi_('setupDriveFolders',{},function(correlationId){return withScriptLock_(function(){var user=setupUser_(),rootId=getConfigValue_('DRIVE_ROOT_FOLDER_ID',true),root;try{root=DriveApp.getFolderById(rootId);}catch(e){throw appError_('DRIVE_FOLDER_INVALID','DRIVE_ROOT_FOLDER_ID cannot be accessed.',false);}var definitions={DRIVE_RECEIPTS_FOLDER_ID:'Receipts and Invoices',DRIVE_CANVASS_FOLDER_ID:'Canvass Evidence',DRIVE_RELEASE_FOLDER_ID:'Release Confirmations',DRIVE_DELIVERABLE_FOLDER_ID:'Deliverable Evidence',DRIVE_LENDING_FOLDER_ID:'Lending Evidence',DRIVE_ARCHIVE_FOLDER_ID:'Archive and Recovery'},created=[];Object.keys(definitions).forEach(function(key){var current=configMap_()[key];if(current&&current!=='TO_BE_ASSIGNED')return;var folder=root.createFolder(definitions[key]);setConfigValue_(key,folder.getId(),'PRODUCTION',definitions[key],'VALID',user);created.push({key:key,id:folder.getId(),name:definitions[key]});});audit_('SETUP_DRIVE_FOLDERS','CONFIG','DRIVE',user,correlationId,{after:created});return{created:created,validation:validateDriveConfiguration_()};});});}
function setupTimeTriggers(){return guardApi_('setupTimeTriggers',{},function(){var user=setupUser_(),wanted={updateOverdueLending:{hour:2},scheduledBackup:{hour:3}},existing=ScriptApp.getProjectTriggers(),created=[];Object.keys(wanted).forEach(function(handler){if(existing.some(function(t){return t.getHandlerFunction()===handler;}))return;ScriptApp.newTrigger(handler).timeBased().everyDays(1).atHour(wanted[handler].hour).create();created.push(handler);});return{created:created,existing:ScriptApp.getProjectTriggers().map(function(t){return t.getHandlerFunction();}),actor:user.User_ID};});}
function seedRolesAndPermissions(users){return guardApi_('seedRolesAndPermissions',{count:(users||[]).length},function(correlationId){return withScriptLock_(function(){var actor=setupUser_();if(!Array.isArray(users)||!users.length)throw appError_('VALIDATION_ERROR','Provide at least one explicit user record.',false);var added=[];users.forEach(function(input){var email=normalizeEmail_(requireText_(input.email,'email'));if(findAll_(HAU_SHEETS.USERS,function(u){return normalizeEmail_(u.Email)===email;}).length)return;var role=requireText_(input.role,'role').toUpperCase();if(!ROLE_PERMISSIONS_[role])throw appError_('VALIDATION_ERROR','Unknown role: '+role,false);var permissions=ROLE_PERMISSIONS_[role],row={User_ID:allocateId_('USR',{year:false}),Email:email,Display_Name:input.displayName||email,Role:role,Committee:input.committee||'',Active:true,Can_Review:permissions.indexOf('Can_Review')>=0,Can_Release:permissions.indexOf('Can_Release')>=0,Can_Receive:permissions.indexOf('Can_Receive')>=0,Can_Admin:permissions.indexOf('Can_Admin')>=0,Created_At:nowIso_(),Updated_At:nowIso_(),Last_Login_At:'',Notes:input.notes||''};appendObject_(HAU_SHEETS.USERS,row);added.push(row.User_ID);});audit_('SEED_USERS_ACCESS','USERS_ACCESS','BATCH',actor,correlationId,{after:{added:added}});return{added:added};});});}
function legacySnapshot_(spreadsheetId){var db=SpreadsheetApp.openById(spreadsheetId),out={};HAU_CONFIG.LEGACY_SHEETS.forEach(function(name){var s=db.getSheetByName(name),values=s?s.getDataRange().getValues():[];out[name]={rows:values.length,nonEmpty:values.reduce(function(n,row){return n+row.filter(function(v){return v!==''&&v!=null;}).length;},0),digest:Utilities.base64Encode(Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,JSON.stringify(values))).slice(0,24)};});return out;}
function healthCheck_(correlationId){var schema=validateDatabaseSchema_(),drive=validateDriveConfiguration_(),productionLegacy=legacySnapshot_(HAU_CONFIG.SPREADSHEET_ID),backupLegacy=legacySnapshot_(HAU_CONFIG.BACKUP_SPREADSHEET_ID),legacyMatches={};HAU_CONFIG.LEGACY_SHEETS.forEach(function(name){legacyMatches[name]=productionLegacy[name].digest===backupLegacy[name].digest;});var items=readObjects_(HAU_SHEETS.ITEMS);return{appVersion:HAU_CONFIG.APP_VERSION,schema:schema,drive:drive,itemMaster:{records:items.length,verify:items.filter(function(i){return String(i.Status)==='VERIFY';}).length,zero:items.filter(function(i){return Number(i.Opening_Qty)===0;}).length},legacyMatchesBackup:legacyMatches,correlationId:correlationId};}
