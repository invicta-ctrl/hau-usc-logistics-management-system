{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hau-usc-logistics",
  "main": "./src/worker/index.js",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hau-usc-logistics-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations",
      "migrations_table": "d1_migrations"
    }
  ],
  "vars": {
    "ENVIRONMENT": "DEVELOPMENT",
    "APP_VERSION": "0.6.0",
    "SCHEMA_VERSION": "1.0.0",
    "BOOTSTRAP_CONTRACT_VERSION": "2",
    "CANDIDATE_SHA": "LOCAL_UNFROZEN"
  },
  "env": {
    "staging": {
      "name": "hau-usc-logistics-staging",
      "workers_dev": true,
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "REPLACE_PRIVATELY_STAGING_D1",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "./migrations",
          "migrations_table": "d1_migrations"
        }
      ],
      "vars": {
        "ENVIRONMENT": "STAGING",
        "APP_VERSION": "0.6.0",
        "SCHEMA_VERSION": "1.0.0",
        "BOOTSTRAP_CONTRACT_VERSION": "2",
        "CANDIDATE_SHA": "REPLACE_AT_CANDIDATE_FREEZE"
      }
    }
  }
}
