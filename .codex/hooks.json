{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/load-route-context.py\"",
            "command_windows": "py -3 \"$(git rev-parse --show-toplevel)/.codex/hooks/load-route-context.py\"",
            "timeout": 10,
            "statusMessage": "Loading validated route context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use_policy.py\"",
            "command_windows": "py -3 \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use_policy.py\"",
            "timeout": 10,
            "statusMessage": "Checking route safety before edit"
          }
        ]
      }
    ]
  }
}
